---
import type { Lang } from '../consts.ts';
import { SITE } from '../consts.ts';
import { otherLang, path, t } from '../i18n/utils.ts';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  section?: 'notes' | 'labs' | 'thoughts' | 'about';
  /** Language-switch target. Pass the mirrored URL for content pages. */
  altHref?: string;
  /** Set on article pages so search engines see the pairing. */
  canonical?: string;
}

const { lang, title, description, section, altHref, canonical } = Astro.props;
const tr = t(lang);
const desc = description ?? tr('site.tagline');
const other = otherLang(lang);

const pageTitle = title === SITE.author ? `${SITE.author} — ${tr('site.tagline')}` : `${title} · ${SITE.author}`;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.site ?? SITE.url);
const altUrl = new URL(altHref ?? path(other, section ?? ''), Astro.site ?? SITE.url);
---

<html lang={lang === 'zh' ? 'zh-CN' : 'en'} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={other === 'zh' ? 'zh-CN' : 'en'} href={altUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.author} (${lang})`} href={`/rss-${lang}.xml`} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta name="twitter:card" content="summary" />

    {/* Applied before first paint so there is no flash of the wrong theme. */}
    <script is:inline>
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem('theme');
        } catch {}
        const dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
  </head>

  <body>
    <Header lang={lang} section={section} altHref={altHref} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
