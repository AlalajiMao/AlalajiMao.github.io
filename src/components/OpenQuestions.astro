---
import type { Lang } from '../consts.ts';
import { t } from '../i18n/utils.ts';

interface Props {
  lang: Lang;
  questions: string[];
}

const { lang, questions } = Astro.props;
const tr = t(lang);
---

{
  questions.length > 0 && (
    <section class="panel open-questions" aria-labelledby="open-questions">
      <p class="panel-title" id="open-questions">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" aria-hidden="true">
          <path d="M9.1 9a3 3 0 1 1 4.2 2.8c-.8.4-1.3 1.2-1.3 2.1v.6" /><path d="M12 17.5v.5" />
          <circle cx="12" cy="12" r="9" />
        </svg>
        {tr('notes.openQuestions')}
      </p>
      <p class="panel-hint">{tr('notes.openQuestions.hint')}</p>
      <ol>
        {questions.map((q) => (
          <li>{q}</li>
        ))}
      </ol>
    </section>
  )
}
