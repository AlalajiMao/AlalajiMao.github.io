---
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<button class="icon-btn" id="theme-toggle" type="button" title={label} aria-label={label}>
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
    stroke-linecap="round" aria-hidden="true">
    <g class="i-sun">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"
      ></path>
    </g>
    <g class="i-moon">
      <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5z"></path>
    </g>
  </svg>
</button>

<style>
  .i-moon {
    display: none;
  }
  :global(:root[data-theme='dark']) .i-sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .i-moon {
    display: inline;
  }
</style>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* private mode — the choice just won't persist */
    }
  });
</script>
