---
import type { Lang, NoteStatus } from '../consts.ts';
import { t } from '../i18n/utils.ts';

interface Props {
  status: NoteStatus;
  lang: Lang;
}
const { status, lang } = Astro.props;
const tr = t(lang);
---

<span class={`badge badge-${status}`} title={tr(`status.${status}.hint`)}>
  <span class="dot"></span>{tr(`status.${status}`)}
</span>
