---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import type { Lang } from '../consts.ts';
import { formatDate, groupNotes, noteSlug, path, published, readingTime, t } from '../i18n/utils.ts';
import StatusBadge from './StatusBadge.astro';
import SourceAnchor from './SourceAnchor.astro';
import OpenQuestions from './OpenQuestions.astro';
import SeriesMap from './SeriesMap.astro';

interface Props {
  entry: CollectionEntry<'notes'>;
  lang: Lang;
}

const { entry, lang } = Astro.props;
const tr = t(lang);

const { Content, headings } = await render(entry);

const { series } = groupNotes(await published('notes', lang));
const parent = entry.data.series ? series.find((s) => s.slug === entry.data.series) : undefined;

const isOverview = entry.data.order === 0;
const siblings = parent?.chapters ?? [];
const index = siblings.findIndex((e) => e.id === entry.id);
const prev = isOverview ? undefined : index > 0 ? siblings[index - 1] : parent?.overview;
const next = isOverview ? siblings[0] : index >= 0 ? siblings[index + 1] : undefined;

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const minutes = readingTime(entry.body ?? '', lang);
---

<div class="note-layout">
  <article>
    <header class="article-head">
      {
        parent && (
          <p class="breadcrumb">
            <a href={path(lang, 'notes')}>{tr('notes.title')}</a>
            <span aria-hidden="true"> / </span>
            <a href={path(lang, 'notes', parent.slug)}>{parent.title}</a>
          </p>
        )
      }
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.description}</p>

      <div class="article-meta">
        <StatusBadge status={entry.data.status} lang={lang} />
        <span>{tr('meta.created')} {formatDate(entry.data.created, lang)}</span>
        {entry.data.updated && <span>· {tr('meta.updated')} {formatDate(entry.data.updated, lang)}</span>}
        <span>· {tr('meta.readingTime', { n: minutes })}</span>
        {
          entry.data.tags.length > 0 && (
            <span class="tag-row">
              {entry.data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </span>
          )
        }
      </div>
    </header>

    {entry.data.source && <SourceAnchor lang={lang} source={entry.data.source} />}

    {
      isOverview && parent && parent.chapters.length > 0 && (
        <div class="series-map-slot">
          <SeriesMap lang={lang} chapters={parent.chapters} />
        </div>
      )
    }

    <div class="prose article-body">
      <Content />
    </div>

    <OpenQuestions lang={lang} questions={entry.data.openQuestions} />

    {
      (prev || next) && (
        <nav class="pager" aria-label={tr('notes.title')}>
          {prev ? (
            <a href={path(lang, 'notes', noteSlug(prev))} rel="prev">
              <span class="dir">← {tr('notes.prev')}</span>
              <span class="ttl">{prev.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {next && (
            <a class="next" href={path(lang, 'notes', noteSlug(next))} rel="next">
              <span class="dir">{tr('notes.next')} →</span>
              <span class="ttl">{next.data.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>

  {
    toc.length > 1 && (
      <aside class="toc-rail">
        <span class="eyebrow">{tr('notes.toc')}</span>
        <ol>
          {toc.map((h) => (
            <li class={h.depth === 3 ? 'd3' : undefined}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ol>
      </aside>
    )
  }
</div>

<style>
  .series-map-slot {
    margin-top: 1.5rem;
  }
  .article-body {
    margin-top: 2rem;
  }
</style>
